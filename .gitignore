# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv

# Environment variables (CRITICAL - never commit secrets)
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db

# Uploads (privacy-first: never store user files)
uploads/
temp/
*.tmp

# Logs
*.log
logs/

# Virtual Environment
venv/
.venv/

# Reference data (too large for git)
data/reference/real/
data/reference/ai/

# But keep the database file (it's small)
!data/reference/clip_database.pkl

# Keep directory structure
!data/reference/.gitkeep

# Development artifacts (never commit these)
*.sh
*.backup
diagnostic_report.txt
test_output.txt
test_details.txt
clip_temp.txt

# Dataset images - never commit these, too large
data/real/**/*.jpg
data/real/**/*.jpeg
data/real/**/*.png
data/real/**/*.tif
data/real/**/*.tiff
data/ai/**/*.jpg
data/ai/**/*.jpeg
data/ai/**/*.png
# Keep .gitkeep and manifest.csv
!data/**/.gitkeep
!data/manifest.csv
