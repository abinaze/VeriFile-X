# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv

# Environment variables (CRITICAL - never commit secrets)
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db

# Uploads (privacy-first: never store user files)
uploads/
temp/
*.tmp

# Logs
*.log
logs/

# Virtual Environment
venv/
.venv/

# Reference data / trained models (too large for git -- use HuggingFace directly)
data/reference/real/
data/reference/ai/
data/reference/*.pkl
data/reference/*.pt
data/reference/*.json
data/reference/*.sha256
data/reference/*.csv
!data/reference/.gitkeep

# Keep directory structure
!data/**/.gitkeep

# Development artifacts (never commit these)
*.sh
*.backup
diagnostic_report.txt
test_output.txt
test_details.txt
clip_temp.txt

# Dataset images - never commit these, too large
data/real/**/*.jpg
data/real/**/*.jpeg
data/real/**/*.png
data/real/**/*.tif
data/real/**/*.tiff
data/ai/**/*.jpg
data/ai/**/*.jpeg
data/ai/**/*.png
# Keep .gitkeep and manifest.csv
!data/**/.gitkeep
!data/manifest.csv

# Dataset metadata files - not needed in git
data/**/*.parquet
data/**/*.tsv

# Large manifest files - tracked locally only
data/manifest_real.csv
data/manifest_ai.csv
data/real/**/*.zip
data/ai/**/*.zip
data/real/**/*.tar
data/ai/**/*.tar
*.zip
*.tar.gz
