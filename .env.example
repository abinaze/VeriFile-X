# VeriFile-X Environment Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# FILE UPLOAD SETTINGS
# =============================================================================

# Maximum file size for upload (in MB)
MAX_FILE_SIZE_MB=50

# Maximum file size for analysis (in MB) - smaller than upload for CPU-intensive ops
MAX_ANALYSIS_SIZE_MB=10

# =============================================================================
# CACHE SETTINGS
# =============================================================================

# Cache time-to-live in minutes (how long results are cached)
CACHE_TTL_MINUTES=60

# Maximum number of cached forensic reports
MAX_CACHE_SIZE=500

# =============================================================================
# API CONFIGURATION
# =============================================================================

# CORS allowed origins (comma-separated)
# Development: http://localhost:3000
# Production: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:3000

# API rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=10

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Debug mode (set to False in production!)
DEBUG=False

# Secret key for sessions (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# SECRET_KEY=your-secret-key-here

# =============================================================================
# ML MODEL SETTINGS
# =============================================================================

# Device for PyTorch models (cuda or cpu)
# Auto-detected if not set
# TORCH_DEVICE=cuda

# Model cache directory (for downloaded models)
# MODEL_CACHE_DIR=~/.cache/torch/hub/checkpoints

# =============================================================================
# LOGGING
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log format
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# =============================================================================
# PRODUCTION DEPLOYMENT SETTINGS
# =============================================================================

# Server host and port
HOST=0.0.0.0
PORT=8000

# Number of worker processes (for production servers like Gunicorn)
WORKERS=4
