# VeriFile-X Production Configuration (repo-root)
# Copy this file to .env (repo root) in production and update values.
# Same loading rule as .env.example (see that file) -- this is the
# repo-root variant, for servers started with `uvicorn backend.main:app`
# from the top-level directory (matches the Dockerfile's WORKDIR /app +
# `uvicorn backend.main:app` CMD).

# CRITICAL: Set these for production!
DEBUG=False
CORS_ORIGINS=https://verifile-x.com,https://www.verifile-x.com

# Rate limiting
RATE_LIMIT_PER_MINUTE=10

# File limits
MAX_FILE_SIZE_MB=50
MAX_ANALYSIS_SIZE_MB=10

# Cache
CACHE_TTL_MINUTES=60
MAX_CACHE_SIZE=500

# Logging (use INFO or WARNING in production)
LOG_LEVEL=INFO

# Server (for Gunicorn/Uvicorn)
HOST=0.0.0.0
PORT=8000
WORKERS=4
